# Global CR API token used by all workers; users only configure Telegram delivery.
CRAPI_TOKEN=replace_with_cr_api_token
CRAPI_URL=http://147.135.212.197/crapi/had/viewstats
# Optional CR API filters
# CRAPI_DT1=
# CRAPI_DT2=
# CRAPI_RECORDS=
# CRAPI_FILTERNUM=
# CRAPI_FILTERCLI=

# Telegram credentials are saved per dashboard account.

# Optional private dashboard bearer token for automation
DASHBOARD_TOKEN=use_a_long_random_private_value
# Required in production: stable key used to encrypt per-user credentials at rest
SETTINGS_ENCRYPTION_KEY=generate_a_long_random_32_byte_secret

# Admin bootstrap account; change these before deployment
ADMIN_USERNAME=change_admin_username
ADMIN_PASSWORD=change_this_to_a_long_random_password

# Railway persistent-volume mount for accounts, encrypted settings, and runtime state
# DATA_DIR=/app/data

# Optional polling interval in milliseconds
# POLL_INTERVAL_MS=30000
